# VeritasCRAG Environment Configuration

# General Application Settings
PROJECT_NAME="VeritasCRAG"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Docling / Ingestion Settings
# Device for ML models: "mps" (Apple Silicon M4), "cuda", or "cpu"
ACCELERATOR_DEVICE="mps"
ENABLE_OCR=false
OCR_ENGINE="easyocr"  # "easyocr", "tesseract", or "mac"
ENABLE_TABLE_STRUCTURE=true
MAX_FILE_SIZE_MB=50

# Future Phases (Retrieval & LLM)
# LLM Providers (OpenAI, Anthropic, Gemini, Groq, Ollama)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Vector Store (e.g., Qdrant, Chroma)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# Web Search for Corrective Fallback (Tavily, DuckDuckGo)
TAVILY_API_KEY=""
